+  runtimeState.factionShipyardSeedCounters =
+    runtimeState.factionShipyardSeedCounters &&
+    typeof runtimeState.factionShipyardSeedCounters === "object"
+      ? runtimeState.factionShipyardSeedCounters
+      : {};

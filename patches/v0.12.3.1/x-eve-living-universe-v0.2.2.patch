+}
+
+function readPrologueRecord(characterID) {
+  const numericCharacterID = toPositiveInt(characterID, null);
+  const table = readTable();
+  return normalizePrologueRecord(
+    numericCharacterID ? table[String(numericCharacterID)] : {},
+    numericCharacterID,

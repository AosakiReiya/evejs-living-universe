+function dictValue(dict, key) {
+  const entries = dict && dict.type === "dict" && Array.isArray(dict.entries)
+    ? dict.entries
+    : [];
+  const pair = entries.find((entry) => Array.isArray(entry) && entry[0] === key);
+  return pair ? pair[1] : undefined;
+}
+
+function main() {

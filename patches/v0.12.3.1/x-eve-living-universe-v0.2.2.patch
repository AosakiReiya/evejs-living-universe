+    deposit.status = "delivered";
+    deposit.deliveredAtMs = nowMs;
+    deposit.lastError = null;
+    deposit.grossMarketValue = roundMoney(
+      deposit.outputValuations.reduce(
+        (sum, output) => sum + toFiniteNumber(output.grossValue, 0),
+        0,
+      ),
+    );

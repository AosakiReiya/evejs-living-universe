+  const reserved = new Set(
+    (Array.isArray(job.reservedInputTypeIDs) ? job.reservedInputTypeIDs : [])
+      .map((value) => toPositiveInt(value, 0))
+      .filter(Boolean),
+  );
+  const pendingInputs = [];
+  for (const input of job.inputs) {
+    if (reserved.has(input.typeID)) continue;

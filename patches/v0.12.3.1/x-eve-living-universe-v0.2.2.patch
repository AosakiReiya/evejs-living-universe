+  const typeID = Number(response.type_id || response.typeID || 0);
+  if (!stationID || !typeID) {
+    return;
+  }
+  const key = stockKey(stationID, typeID);
+  stockMap.set(key, {
+    ...getStockRow(stockMap, stationID, typeID),

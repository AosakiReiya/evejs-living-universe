+    blueprintTypeID: recipe.blueprintTypeID,
+    blueprintName: recipe.blueprintName,
+    productTypeID: candidate.good.typeID,
+    productTypeName: candidate.good.name,
+    targetLevel,
+    copyRuns,
+    runs: copyRuns,

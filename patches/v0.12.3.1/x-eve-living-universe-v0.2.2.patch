+          adjustmentID: `${deposit.depositID}:refine:${output.typeID}`,
+          station,
+          good,
+          deltaQuantity: output.quantity,
+          reason: `NPC refinery receipt ${deposit.depositID}`,
+          stockMap,
+        },
+      });

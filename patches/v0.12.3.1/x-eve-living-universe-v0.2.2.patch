+    { name: "Antimatter Charge S", quantity: 1_500 },
+    { name: "Core Scanner Probe I", quantity: 16 },
+  ]),
+  droneBay: Object.freeze([
+    { name: "Hobgoblin I", quantity: 8 },
+  ]),
+  preloadCharges: Object.freeze([

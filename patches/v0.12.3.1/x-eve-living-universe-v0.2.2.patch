+}
+
+function getMetrics() {
+  return {
+    ...metrics,
+    pending: creditByActorID.size,
+  };
+}
+
+// Test/maintenance hook.
+function _reset() {
+  creditByActorID.clear();
+  lastSweepAtMs = 0;
+  metrics.recorded = 0;
+  metrics.consumed = 0;
+  metrics.expired = 0;
+}
+
+module.exports = {
+  recordPlayerKillCredit,
+  consumeKillCredit,
+  peekKillCredit,
+  getMetrics,
+  TTL_MS,
+  _reset,
+};

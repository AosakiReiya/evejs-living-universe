+    [CATEGORY.REPAIR]: military || logistics ? 0.35 : 0.15,
+    [CATEGORY.SHIP]: industrial || military ? 0.08 : 0.02,
+    [CATEGORY.ICE_PRODUCT]: industrial ? 0.25 : 0.08,

+  const normalizedActorID = String(actorID || "").trim();
+  if (!normalizedActorID) {
+    return 0;
+  }
+  sweepExpired(nowMs);
+  const entry = creditByActorID.get(normalizedActorID);
+  if (!entry) {
+    return 0;
+  }
+  creditByActorID.delete(normalizedActorID);

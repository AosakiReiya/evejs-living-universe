+        typeof options.assignFreightRoute === "function"
+          ? options.assignFreightRoute
+          : null;
+      lastMarkLivingStateDirty =
+        typeof options.markLivingStateDirty === "function"
+          ? options.markLivingStateDirty
+          : null;
+    },
+  },
+};

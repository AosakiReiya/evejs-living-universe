+  assert.equal(new Set(entityEwarModuleIDs).size, entityEwarModuleIDs.length);
+  for (const entry of entityEwarModules) {
+    const resolvedEffect =
+      spaceRuntime._testing.resolveGenericModuleActivationEffectForTesting(

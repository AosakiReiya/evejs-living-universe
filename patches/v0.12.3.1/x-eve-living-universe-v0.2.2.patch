+    { moduleName: "Core Probe Launcher I", chargeName: "Core Scanner Probe I", fullClip: true },
+  ]),
+});
+
+const GNOSIS_PRESET = Object.freeze({
+  commandName: "/estateprologue",
+  shipName: "Gnosis",

+  FACTIONS,
+  INDUSTRIAL_CORPORATION_IDS,
+  PIRATE_CORPORATION_BY_KEY,
+  ROLE_POOLS,
+  resolveAffiliation,
+  _testing: {
+    deterministicUnit,
+    getProfession,
+    getRegionalFaction,
+    getStationOwner,
+  },
+};

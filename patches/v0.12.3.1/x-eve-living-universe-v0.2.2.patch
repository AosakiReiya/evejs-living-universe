+        station_id: order.stationID,
+        type_id: order.typeID,
+        delta_quantity: -preview.quantity,
+        new_quantity: null,
+        new_price: null,
+        reason: `living procurement rollback ${order.orderID}`,
+        adjustment_id: `living-procurement-rollback:${fillToken}`,

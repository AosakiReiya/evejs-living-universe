+      circuitTrips: 0,
+      circuitRecoveries: 0,
+      handoffAttempts: 0,
+      handoffSuccesses: 0,
+      handoffBlocked: 0,
+      handoffFailures: 0,
+      reconciliationRuns: 0,
+      reconciliationFailures: 0,
+      sourceCheckpointAttempts: 0,

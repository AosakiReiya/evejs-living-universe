+      job.recoveryClaimedAtMs = nowMs;
+      job.returnsAtMs = nowMs + site.travelMs;
+      job.lastUpdatedAtMs = nowMs;
+      site.status = "returning";
+      site.lastUpdatedAtMs = nowMs;
+      for (const wreck of site.wrecks) {

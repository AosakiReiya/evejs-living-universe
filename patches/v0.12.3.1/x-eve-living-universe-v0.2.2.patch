+fn append_static_topology(
+    connection: &mut Connection,
+    input: &SeedInputData,
+    progress: &ProgressBar,
+) -> Result<()> {
+    let transaction = connection.transaction()?;
+    {
+        let mut statement = transaction
+            .prepare("INSERT OR IGNORE INTO regions (region_id, region_name) VALUES (?1, ?2)")?;
+        for region in &input.topology_regions {
+            statement.execute(params![region.region_id, region.region_name])?;
+            progress.inc(1);
+        }
+    }
+    {
+        let mut statement = transaction.prepare(
+            "INSERT OR IGNORE INTO solar_systems (
+               solar_system_id, region_id, constellation_id, solar_system_name, security
+             ) VALUES (?1, ?2, ?3, ?4, ?5)",
+        )?;
+        for system in &input.topology_solar_systems {
+            statement.execute(params![
+                system.solar_system_id,
+                system.region_id,
+                system.constellation_id,
+                system.solar_system_name,
+                system.security
+            ])?;
+            progress.inc(1);
+        }
+    }
+    {
+        let mut statement = transaction.prepare(
+            "INSERT OR IGNORE INTO stations (
+               station_id, solar_system_id, constellation_id, region_id, station_name, security
+             ) VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
+        )?;
+        for station in &input.topology_stations {
+            statement.execute(params![
+                station.station_id,
+                station.solar_system_id,
+                station.constellation_id,
+                station.region_id,
+                station.station_name,
+                station.security
+            ])?;
+            progress.inc(1);
+        }
+    }
+    transaction.commit()?;
+    Ok(())
+}

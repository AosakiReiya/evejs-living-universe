+  );
+  const pirateActors = actors.filter((actor) => actor.role === "highsec_pirate");
+  const pirateFactionIDs = new Set([500010, 500011, 500012, 500019, 500020]);
+  assert.ok(
+    pirateActors.every((actor) => (

+  FAMILY_ESTATE_PROLOGUE_TABLE,
+  FAMILY_ESTATE_PROLOGUE_VERSION,
+  appendHistory,
+  cloneValue,
+  normalizePrologueRecord,
+  readPrologueRecord,
+  updatePrologueRecord,
+  writePrologueRecord,

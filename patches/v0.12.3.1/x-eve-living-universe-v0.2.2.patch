+        "X-Eve meta row is not an object",
+        { path: "/meta" },
+      );
+    }
+    return meta;
+  }
+
+  function saveMeta(meta) {
+    if (!meta || typeof meta !== "object" || Array.isArray(meta)) {
+      throw new XEveStateError(
+        "X_EVE_STATE_SHAPE_INVALID",
+        "X-Eve meta row must be an object",
+        { path: "/meta" },

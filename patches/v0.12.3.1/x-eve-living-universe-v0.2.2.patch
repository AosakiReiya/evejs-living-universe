+      if (!changedVisiblePilotsBySystemID.has(record.solarSystemID)) {
+        changedVisiblePilotsBySystemID.set(record.solarSystemID, []);
+      }
+      changedVisiblePilotsBySystemID.get(record.solarSystemID).push(record);
+    }
+  }

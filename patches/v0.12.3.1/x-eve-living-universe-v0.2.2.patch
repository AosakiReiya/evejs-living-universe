+    const error = new Error(
+      economyCommit && economyCommit.errorMsg || "LIVING_ECONOMY_RESET_COMMIT_FAILED",
+    );
+    error.code = economyCommit && economyCommit.errorMsg ||
+      "LIVING_ECONOMY_RESET_COMMIT_FAILED";

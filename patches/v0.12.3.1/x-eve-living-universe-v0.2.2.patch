@@ -0,0 +1,286 @@
+"use strict";
+
+const path = require("path");
+
+const config = require(path.join(__dirname, "../../config"));
+
+const DEFAULT_PER_SYSTEM_LIMIT = 48;
+const DEFAULT_GLOBAL_LIMIT = 120;

+function createEmptyMetrics() {
+  return {
+    reservationsGranted: 0,
+    idempotentReservations: 0,
+    releases: 0,
+    releaseMisses: 0,
+    deniedGlobal: 0,
+    deniedSystem: 0,
+    deniedInvalid: 0,
+    deniedConflict: 0,
+  };

+    [CATEGORY.EXPLORATION]: 0.25,
+    [CATEGORY.REPAIR]: 0.25,
+    [CATEGORY.SHIP]: 0.12,
+  };
+  return Object.fromEntries(Object.entries(minimums).map(([category, minimum]) => [
+    category,
+    Math.max(Number(production && production[category]) || 0, minimum),
+  ]));
+}

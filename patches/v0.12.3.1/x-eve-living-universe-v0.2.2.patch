+        economyReset.token,
+      );
+      if (!rollbackFinalize || rollbackFinalize.success !== true) {
+        rollbackFlush = rollbackFinalize || {
+          success: false,
+          errorMsg: "LIVING_ECONOMY_RESET_ROLLBACK_FINALIZE_FAILED",
+        };
+      }

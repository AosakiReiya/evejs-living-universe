+    return false;
+  }
+  sweepExpired(nowMs);
+  creditByActorID.set(normalizedActorID, {
+    characterID: normalizedCharacterID,
+    recordedAtMs: nowMs,
+  });
+  metrics.recorded += 1;
+  return true;
+}
+
+// Consume (and remove) the credit for a living actor's loss. Returns the killer characterID or 0.

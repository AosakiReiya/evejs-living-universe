+      throw new Error(
+        "faction shipyard replenishment returned an invalid response count",
+      );
+    }
+    for (let index = 0; index < requests.length; index += 1) {
+      const entry = requests[index];
+      const response = responses[index];
+      updateStockMap(stockMap, response);

+  const requests = [];
+  const buildSeedEntry = (stationEntry, typeID, good, quantity, kind) => {
+    const counterKey = `${stationEntry.stationID}:${typeID}`;
+    const sequence = toPositiveInt(
+      runtimeState.factionShipyardSeedCounters[counterKey],
+      0,
+    );

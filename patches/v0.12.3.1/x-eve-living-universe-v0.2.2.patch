+// actorID -> { characterID, recordedAtMs }
+const creditByActorID = new Map();
+let lastSweepAtMs = 0;
+
+const metrics = {
+  recorded: 0,
+  consumed: 0,
+  expired: 0,
+};
+
+function toPositiveInt(value, fallback = 0) {
+  const numeric = Math.trunc(Number(value));
+  return Number.isFinite(numeric) && numeric > 0 ? numeric : fallback;
+}
+

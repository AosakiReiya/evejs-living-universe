+      }
+    }
+    if (
+      receipt &&
+      isActiveJob(job) &&
+      (!catalog.getStation(job.sourceStationID) || !catalog.getGood(job.typeID))
+    ) {
+      const quarantine = estateRuntime.quarantineFamilyEstateNpcDelivery(
+        job.jobID,
+        "source-catalog-entry-missing",
+        nowMs,
+      );

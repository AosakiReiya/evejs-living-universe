* text=auto

# Keep the canonical patch and its integrity metadata byte-stable on Windows.
*.patch text eol=lf
*.json text eol=lf
SHA256SUMS text eol=lf

# These release artifacts are hashed byte-for-byte by the installer and audit.
# Preserve the exact validated bytes instead of normalizing them at commit time.
patches/v0.12.3/*.patch -text -eol
patches/v0.12.3/baseline-manifest.json -text -eol
patches/v0.12.3/installed-manifest.json -text -eol
patches/v0.12.3/SHA256SUMS -text -eol

# Repository documentation and automation use stable source line endings.
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# These entry points are intended for Windows hosts.
*.ps1 text eol=crlf
*.bat text eol=crlf

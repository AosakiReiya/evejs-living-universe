* text=auto

# Repository documentation and automation use stable source line endings.
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# These entry points are intended for Windows hosts.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Overlay content is hashed byte-for-byte by xeve-patch and the audit.
# Preserve the exact validated bytes instead of normalizing them at commit time.
patches/files/** -text whitespace=-trailing-space
patches/docker-overlay/** -text whitespace=-trailing-space
patches/manifest.json -text whitespace=-trailing-space

# Legacy v0.2.3 release data (patch + manifests) is also hash-verified.
legacy/patches/** -text whitespace=-trailing-space
